    "fit": [
      {
        "id": "smart",
        "desc": "Default. Cover-crop to 16:9 unless the crop would cut the subject's safe band around `focus` or lose more than ~15% (portraits, small archive scans, documents, panoramas over 2.1:1): then the whole picture on a soft, dimmed, moving copy of itself (a paper print in collage genres). Camera moves stay inside the picture."
      },
      {
        "id": "cover",
        "desc": "Always fill the frame (crop to 16:9 around `focus`)."
      },
      {
        "id": "contain",
        "desc": "Always show the whole picture (documents, text, anything that must not be cropped)."
      }
    ],
    "energy": {
      "field": "energy",
      "values": [
        1,
        2,
        3,
        4,
        5
      ],
      "desc": "How much the shot moves. Scales a DERIVED camera (1 = still/hold, 3 = the mood alone, 5 = fast push or punch that lands early) and the intensity of the scene's effects (x0.55 .. x1.3). An explicit `camera` keeps its speed. Absent = 3."
    },
    "pace": {
      "field": "pace",
      "values": [
        "hold",
        "normal",
        "quick",
        "rapid"
      ],
      "desc": "Cut-ins inside a picture scene: hold = one continuous shot (camera static/drift at most), normal = the camera decides, quick = 1-2 cut-ins, rapid = 3-4 short cut-ins; each lands on a narration word and alternates crops around the focus. Never on a contained picture. Absent = normal."
    }
  },
